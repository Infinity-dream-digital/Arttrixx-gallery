rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      // TEMPORAIRE : règles ouvertes pour le tableau de bord protégé uniquement par le code JavaScript.
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll([
          'customerName', 'phone', 'location', 'deliveryTime',
          'items', 'subtotal', 'deliveryFee', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.deliveryFee == 1500
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      // TEMPORAIRE : les commandes et leurs coordonnées sont lisibles/modifiables publiquement.
      allow read, update, delete: if true;
    }
  }
}
