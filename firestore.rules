rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'REMPLACER_PAR_LE_MAIL_ADMIN';
    }

    match /products/{productId} {
      allow read: if resource.data.available == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll([
          'customerName', 'phone', 'location', 'deliveryTime',
          'items', 'subtotal', 'deliveryFee', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.deliveryFee == 1500
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow read, update, delete: if isAdmin();
    }
  }
}
